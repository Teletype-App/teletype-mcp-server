# http or stdio
TRANSPORT=http

HOST=127.0.0.1
PORT=4311
PUBLIC_BASE_URL=http://127.0.0.1:4311
# Comma-separated additional browser origins. Values must not contain paths.
ALLOWED_ORIGINS=

# Required for stdio. HTTP clients pass this credential per request in
# X-Teletype-Api-Token. It is not an HTTP fallback.
TELETYPE_API_TOKEN=

TELETYPE_API_BASE=https://api.teletype.app/public/api/v1
TELETYPE_PROJECT_URL=teletype.app
# Human-readable MCP text. Use ru for Russian. Field names stay the same.
TELETYPE_MCP_LOCALE=en

REQUEST_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=5000000
MAX_UPLOAD_BYTES=20000000
MAX_CONCURRENT_REQUESTS=32
MAX_CONCURRENT_PER_TOKEN=4
# Disabled by default. When enabled in stdio, only canonical paths inside these roots are accepted.
ENABLE_LOCAL_UPLOADS=false
TELETYPE_ALLOWED_FILE_ROOTS=
LOG_LEVEL=info
